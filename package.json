{
  "name": "@howarewoo/pi-btw",
  "version": "0.1.2",
  "description": "Pi coding agent extension for concurrent read-only /btw side conversations with saved thread history.",
  "keywords": [
    "btw",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "read-only",
    "side-chat",
    "side-conversation"
  ],
  "homepage": "https://github.com/howarewoo/pi-btw#readme",
  "bugs": {
    "url": "https://github.com/howarewoo/pi-btw/issues"
  },
  "license": "MIT",
  "author": "Adam Woo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howarewoo/pi-btw.git"
  },
  "files": [
    "index.ts",
    "src",
    "docs/images",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "render:readme": "tsx scripts/render-readme.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "release:check": "node scripts/release-check.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "npm run check && npm run release:check && npm run test:package"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
